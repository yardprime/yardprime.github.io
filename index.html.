      --text-subheading: 24px;
      --leading-subheading: 1.24;
      --tracking-subheading: -0.012em;
      --text-heading-sm: 37px;
      --leading-heading-sm: 1.22;
      --tracking-heading-sm: -0.012em;
      --text-heading: 45px;
      --leading-heading: 1.06;
