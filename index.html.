      --text-heading-lg: 57px;
      --leading-heading-lg: 1.06;
      --tracking-heading-lg: -0.022px;
      --text-display: 80px;
      --leading-display: 1;
      --tracking-display: -2.96px;

      --spacing-5: 5px;
      --spacing-6: 6px;
      --spacing-8: 8px;
      --spacing-10: 10px;
      --spacing-12: 12px;
      --spacing-15: 15px;
      --spacing-20: 20px;
      --spacing-24: 24px;
      --spacing-30: 30px;
      --spacing-40: 40px;
      --spacing-50: 50px;
      --spacing-64: 64px;

      --page-max-width: 1200px;
      --section-gap: 50px;
      --card-padding: 30px;
      --element-gap: 8px;
      --radius-cards: 20px;
      --radius-links: 26px;
      --radius-hero-cards: 30px;
      --radius-inputs: 33px;
      --radius-buttons: 100px;
      --radius-nav-pills: 110px;
      --transition-editorial: 220ms cubic-bezier(0.22, 1, 0.36, 1);

      --surface-bone-canvas: #f1efdf;
      --surface-pure-white: #ffffff;
      --surface-pastel-tiles: #b2cee7;
      --surface-forest-ink: #07503f;
      --surface-vivid-lime: #e8fe85;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 76px;
      font-size: 16px;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }

    body {
      margin: 0;
      background-color: var(--color-bone);
      color: var(--color-charcoal);
      font-family: var(--font-inter);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      letter-spacing: var(--tracking-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font-family: inherit;
    }

    :focus-visible {
      outline: 2px solid var(--color-vivid-lime);
      outline-offset: 2px;
    }

    .on-bone :focus-visible,
    .form-card :focus-visible {
      outline: 2px solid var(--color-forest-ink);
      outline-offset: 2px;
    }

    .container {
      width: 100%;
      max-width: var(--page-max-width);
      margin-inline: auto;
      padding-inline: var(--spacing-20);
    }

    @media (min-width: 768px) {
      .container {
        padding-inline: var(--spacing-30);
      }
    }

    /* Honeypot wrapper: hidden from visual users and screen readers */
    .hp-field {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
    }

    /* ==========================================================================
       EDITORIAL TYPOGRAPHY
       ========================================================================== */
    .editorial-h2 {
      font-family: var(--font-reckless);
      font-weight: 300;
      font-size: clamp(2.125rem, 4.4vw, var(--text-heading-lg));
      line-height: var(--leading-heading-lg);
      letter-spacing: -0.012em;
      margin: 0 0 16px;
    }

    .editorial-lead {
      font-family: var(--font-recklesslight);
      font-weight: 300;
      font-size: clamp(1.5rem, 2.3vw, 1.75rem);
      line-height: 1.24;
      letter-spacing: normal;
      color: var(--color-charcoal);
      max-width: 44ch;
      margin: 0;
    }

    .body-intro {
      font-size: 17px;
      line-height: 1.56;
      letter-spacing: -0.022em;
      color: var(--color-graphite);
      max-width: 60ch;
      margin: 0;
    }

    .small-caps-label {
      display: inline-block;
      font-size: var(--text-caption);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.029em;
      color: var(--color-forest-ink);
      margin-bottom: var(--spacing-12);
    }

    .forest-band .small-caps-label {
      color: var(--color-vivid-lime);
    }

    /* ==========================================================================
       PILL BUTTONS (100px–110px RADIUS, ZERO SHADOW)
       ========================================================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--element-gap);
      border-radius: var(--radius-buttons);
      padding: 10px 24px;
      min-height: 44px;
      font-size: var(--text-body-sm);
      font-weight: 600;
      letter-spacing: var(--tracking-body-sm);
      line-height: 1.2;
      border: 1px solid transparent;
      cursor: pointer;
      transition: background-color var(--transition-editorial), color var(--transition-editorial), border-color var(--transition-editorial), transform var(--transition-editorial);
      text-align: center;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .btn-forest {
      background-color: var(--color-forest-ink);
      color: var(--color-pure-white);
      border-color: var(--color-forest-ink);
    }

    .btn-forest:hover:not(:disabled) {
      background-color: #053d30;
      border-color: #053d30;
    }

    .btn-ghost-light {
      background-color: transparent;
      color: var(--color-pure-white);
      border-color: var(--color-pure-white);
    }

    .btn-ghost-light:hover {
      background-color: var(--color-pure-white);
      color: var(--color-forest-ink);
      border-color: var(--color-pure-white);
    }

    .btn-outline-dark {
      background-color: transparent;
      color: var(--color-graphite);
      border-color: var(--color-graphite);
    }

    .btn-outline-dark:hover {
      background-color: var(--color-forest-ink);
      color: var(--color-pure-white);
      border-color: var(--color-forest-ink);
    }

    .btn-lime {
      background-color: var(--color-vivid-lime);
      color: var(--color-charcoal);
      border-color: var(--color-vivid-lime);
    }

    .btn-lime:hover {
      background-color: #dbf862;
    }

    /* ==========================================================================
       LIME MARQUEE STRIP (#e8fe85, 32px)
       ========================================================================== */
    .marquee-strip {
      background-color: var(--color-vivid-lime);
      color: var(--color-charcoal);
      height: 32px;
      display: flex;
      align-items: center;
      overflow: hidden;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.025em;
    }

    .marquee-track {
      display: flex;
      align-items: center;
      white-space: nowrap;
      will-change: transform;
      animation: marqueeLoop 36s linear infinite;
    }

    .marquee-strip:hover .marquee-track {
      animation-play-state: paused;
    }

    .marquee-item {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-10);
      padding-inline: var(--spacing-24);
    }

