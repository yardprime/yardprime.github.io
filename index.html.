      --font-inter: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-reckless: 'Reckless', 'Cormorant Garamond', Georgia, serif;
      --font-recklesslight: 'RecklessLight', 'Cormorant Garamond', Georgia, serif;

      --text-caption: 12px;
